#!/usr/bin/env bash
# Local gate before push (no hosted CI): the whole unit suite on this machine.
# Enable once per clone: git config core.hooksPath .githooks
# Skip once: git push --no-verify
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
log="${TMPDIR:-/tmp}/a2a-relay-pre-push.log"
if ! command -v hermes >/dev/null 2>&1; then
  echo "pre-push: 'hermes' is not on PATH; the tests run inside Hermes (hermes --run-module)." >&2
  exit 1
fi
if hermes --run-module unittest discover -s "$root/tests" >"$log" 2>&1; then
  tail -n 3 "$log"
else
  tail -n 40 "$log" >&2
  echo "pre-push: tests failed; full log: $log" >&2
  exit 1
fi
